PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_NAME=blog-app

# JWT Configuration
JWT_SECRET=your_jwt_access_secret_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Gmail SMTP Configuration for sending OTP
# Note: To use Gmail, enable 2-Step Verification on your Google Account and generate an App Password:
# https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_gmail_address@gmail.com
MAIL_PASS=your_16_char_gmail_app_password
MAIL_FROM="Blog Platform" <no-reply@blogapp.com>

# Cloudinary Configuration for Image Uploads
# Find these in your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
